            आप सभी को <span id="sender-name">Govind</span> की तरफ से दीपावली की हार्दिक शुभकामनाएँ!
        </div>

        <div id="tyohar-message">
            दीपों का त्यौहार
        </div>
        
        <div id="shubh-message">
            आपको और आपके परिवार को दीपावली की शुभकामनाएँ
        </div>
        
        <div class="input-group">
            <label for="userName">आपका शुभ नाम यहाँ लिखो:</label>
            <input type="text" id="userName" placeholder="आपका नाम लिखिए">
        </div>
        
        <button id="whatsapp-share-button" onclick="shareLink()">
            <i class="fab fa-whatsapp"></i> WhatsApp पर शेयर करें
        </button>
    </div>

    <script>
        let defaultSharerName = "Govind";
        const maxActiveFireworks = 50; // Max number of firework particles to show at any time
        
        // Expanded color list for "Rang Birangi Patakhe"
        const colors = [
            '#FF4500', '#FFD700', '#00BFFF', '#ADFF2F', '#FF69B4', '#FFFFFF', 
            '#9400D3', '#FFA07A', '#00FFFF', '#FF00FF', '#FF8C00', '#7CFC00', 
            '#4169E1', '#F08080', '#32CD32' // Even more colors
        ];

        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            let sharerName = urlParams.get('sharer');

            if (sharerName) {
                sharerName = decodeURIComponent(sharerName); 
            } else {
                sharerName = defaultSharerName;
            }
            
            document.getElementById('sender-name').textContent = sharerName;

            // Start continuous fireworks
            startContinuousFireworks();
        });

        function startContinuousFireworks() {
            // Launch a new set of fireworks every 500ms
            setInterval(() => {
                // Launch a burst of 5 to 10 fireworks
                const burstCount = Math.floor(Math.random() * 6) + 5; 
                createFireworkBurst(burstCount);
            }, 500); 
        }

        function createFireworkBurst(num) {
            const container = document.getElementById('fireworks-container');
            
            // Random launch position (center-top of the screen is common for fireworks)
            const launchX = Math.random() * 80 + 10; 
            const launchY = Math.random() * 30 + 10; 
            
            const randomColor = colors[Math.floor(Math.random() * colors.length)];

            for (let i = 0; i < num; i++) {
                const firework = document.createElement('div');
                firework.classList.add('firework');
                firework.style.left = `${launchX}%`;
                firework.style.top = `${launchY}%`;
                firework.style.backgroundColor = randomColor;
                firework.style.color = randomColor; 

                // Custom animation properties for scattering
                const angle = Math.random() * 2 * Math.PI; // Full circle
                const distance = Math.random() * 50 + 20; // Spread distance
                const endX = launchX + distance * Math.cos(angle) * (Math.random() > 0.5 ? 1 : -1) * 0.5;
                const endY = launchY + distance * Math.sin(angle) * (Math.random() > 0.5 ? 1 : -1) * 0.5;

                // Apply dynamic CSS animation
                firework.style.transition = 'transform 1.5s ease-out, opacity 1.5s ease-out';
                firework.style.transform = `translate(${endX - launchX}vw, ${endY - launchY}vh) scale(0)`;
                firework.style.opacity = '0';
                
                // Add to container
                container.appendChild(firework);
                
                // Trigger the animation after a slight delay to ensure CSS transitions are applied
                setTimeout(() => {
                    firework.style.transform = `translate(${endX - launchX}vw, ${endY - launchY}vh) scale(0)`;
                    firework.style.opacity = '0';
                }, 10);
                
                // Remove the element after its transition finishes
                setTimeout(() => {
                    firework.remove();
                }, 1500);
            }
        }


        function shareLink() {
            const userNameInput = document.getElementById('userName');
            const name = userNameInput.value.trim();
            
            if (name === "") {
                alert("कृपया अपना शुभ नाम लिखिए!");
                return;
            }

            // 1. Generate the Shareable Link (Uses the NEW name)
            const baseURL = window.location.href.split('?')[0];
            const shareableLink = baseURL + '?sharer=' + encodeURIComponent(name);
            
            // 2. Prepare the Message Text
            const shareText = `आपको और आपके परिवार को Happy Diwali! यह मां लक्ष्मी जी का आशीर्वाद आपके लिए भेजा है। इसे देखने और आगे शेयर करने के लिए क्लिक करें: ${shareableLink}`;

            // 3. Attempt to use the Web Share API
            if (navigator.share) {
                navigator.share({
                    title: 'Happy Diwali & Laxmi Ji Blessings',
                    text: shareText,
                    url: shareableLink 
                }).then(() => {
                    console.log('Successful share');
                }).catch((error) => {
                    console.log('Error sharing, falling back to WhatsApp:', error);
                    // Fallback to WhatsApp
                    window.location.href = 'whatsapp://send?text=' + encodeURIComponent(shareText);
                });
            } else {
                // 4. Fallback for older browsers or desktop
                alert("लिंक बन गया है। अब आपको WhatsApp पर साझा करने के लिए निर्देशित किया जा रहा है।");
                window.location.href = 'whatsapp://send?text=' + encodeURIComponent(shareText);
            }
        }
    </script>

